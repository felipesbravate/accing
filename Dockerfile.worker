# Accing image worker (Fly.io). Build: fly deploy (uses fly.toml). Only the pipeline is in this image, not the web app.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates unzip && rm -rf /var/lib/apt/lists/*
COPY worker/package.json ./package.json
# CPU only: onnxruntime-node would otherwise download CUDA libraries (hundreds of MB) the worker never uses.
ENV ONNXRUNTIME_NODE_INSTALL=skip
RUN npm install --omit=dev --no-audit --no-fund
COPY scripts ./scripts
COPY worker ./worker
# The two local models (~350 MB) are baked in, so a woken worker starts working at once.
RUN node worker/fetch-models.mjs
EXPOSE 8080
CMD ["node", "worker/server.mjs"]
